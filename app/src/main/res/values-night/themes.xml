<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application night theme using Material Components -->
    <style name="Theme.SOS" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/red_primary</item>
        <item name="colorPrimaryVariant">@color/red_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/blue_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status Bar & Window Insets -->
        <item name="android:statusBarColor">@color/red_primary_dark</item>
        <item name="android:fitsSystemWindows">true</item>

        <!-- Material Component Styles -->
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SOS.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SOS.Medium</item>

        <!-- Action Bar Customization -->
        <item name="actionBarStyle">@style/Widget.SOS.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.SOS.ActionBar</item>
    </style>
</resources>
